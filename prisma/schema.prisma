// Trace-Bound AI — data model
// The AI-access invariant is enforced in application code (TraceAccessPolicy),
// not by the DB. The schema only stores the facts the policy reads:
// session ownership, session status, per-trace aiAccessAllowed, and soft-delete.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SessionStatus {
  ACTIVE
  ENDED
}

enum TraceType {
  PHOTO
  SOUND
  VOICE
  TEXT
}

// The kind of change captured in the audit log. Focused on permission/state
// changes that are meaningful to a child's consent and safety.
enum AuditAction {
  CREATED
  EDITED
  DELETED
  HIDDEN
  UNHIDDEN
  AI_ACCESS_GRANTED
  AI_ACCESS_REVOKED
  STORY_INCLUDED
  STORY_EXCLUDED
}

model Child {
  id        String    @id @default(cuid())
  name      String
  createdAt DateTime  @default(now())
  sessions  Session[]
}

model Session {
  id         String        @id @default(cuid())
  childId    String
  child      Child         @relation(fields: [childId], references: [id])
  status     SessionStatus @default(ACTIVE)
  createdAt  DateTime      @default(now())
  endedAt    DateTime?
  traces      Trace[]
  aiRequests  AiRequest[]
  bridgeCards BridgeCard[]
  stories     Story[]

  @@index([childId, status])
}

model Trace {
  id              String    @id @default(cuid())
  sessionId       String
  session         Session   @relation(fields: [sessionId], references: [id])
  type            TraceType

  // Text body for TEXT traces, or a caption/transcript for media traces.
  content         String

  // Media storage. `storageKey` is a server-internal, relative key (never an
  // absolute path). The browser gets media via a route handler keyed by traceId,
  // so the filesystem layout is never exposed.
  storageKey      String?
  originalName    String?
  mimeType        String?
  sizeBytes       Int?

  // Permission / visibility state.
  aiAccessAllowed Boolean   @default(false)
  hidden          Boolean   @default(false)
  includeInStory  Boolean   @default(false)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime? // soft delete; a non-null value means excluded from AI

  selections      AiRequestTrace[]
  auditEvents     AuditEvent[]
  bridgeLinks     BridgeCardTrace[]

  @@index([sessionId])
  @@index([sessionId, deletedAt])
}

// Append-only log of meaningful changes to a trace (esp. permission changes).
model AuditEvent {
  id        String      @id @default(cuid())
  traceId   String
  trace     Trace       @relation(fields: [traceId], references: [id])
  action    AuditAction
  // Optional before/after snapshot for the changed field, as JSON text.
  detail    String?
  createdAt DateTime    @default(now())

  @@index([traceId])
}

// Audit record of every AI call: exactly which traces were sent, and the response.
model AiRequest {
  id        String           @id @default(cuid())
  sessionId String
  session   Session          @relation(fields: [sessionId], references: [id])
  prompt    String
  response  String?
  createdAt DateTime         @default(now())
  traces    AiRequestTrace[]

  @@index([sessionId])
}

// Join: the explicit, policy-approved set of traces that crossed the AI boundary.
model AiRequestTrace {
  aiRequestId String
  aiRequest   AiRequest @relation(fields: [aiRequestId], references: [id])
  traceId     String
  trace       Trace     @relation(fields: [traceId], references: [id])

  @@id([aiRequestId, traceId])
}

enum BridgeCardStatus {
  DRAFT
  SAVED
}

// Trace-to-Story Bridge card. Holds FOUR independently-editable fields authored
// by the child/adult — never merged, never AI-classified. A card may reference
// many traces (via BridgeCardTrace). These fields are plain author text; the AI
// modules do not write them.
model BridgeCard {
  id        String           @id @default(cuid())
  sessionId String
  session   Session          @relation(fields: [sessionId], references: [id])

  // The four separate fields. Kept distinct columns on purpose.
  observation         String @default("")
  childInterpretation String @default("")
  childImagination    String @default("")
  storyFunction       String @default("")

  status    BridgeCardStatus @default(DRAFT)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  traces    BridgeCardTrace[]

  @@index([sessionId])
}

// Join: which traces a bridge card references. A card can reference multiple
// traces, and a trace can be referenced by multiple cards.
model BridgeCardTrace {
  bridgeCardId String
  bridgeCard   BridgeCard @relation(fields: [bridgeCardId], references: [id], onDelete: Cascade)
  traceId      String
  trace        Trace      @relation(fields: [traceId], references: [id])

  @@id([bridgeCardId, traceId])
  @@index([traceId])
}

// The child's writing. Plain text only — no rich formatting is stored. Word
// count is derived, not stored, so it can never drift from the body.
model Story {
  id        String   @id @default(cuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id])

  title     String   @default("")
  body      String   @default("") // plain text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reflections StoryReflection[]

  @@index([sessionId])
}

// How the child accounts for the SOURCE of a span of their own writing. The
// child assigns this — authorship is NEVER inferred automatically. The
// reflection is the primary account of where the text came from.
enum ReflectionSourceType {
  WORLD_OBSERVATION
  MY_INTERPRETATION
  MY_IMAGINATION
  INSPIRED_BY_AI_QUESTION
  AI_POSSIBILITY_MODIFIED_BY_ME
}

// Associates a selected span of the story body with a source type the child
// chose. Stored as a character range plus a snapshot of the selected text, so
// the association survives independent of later edits (and is auditable).
model StoryReflection {
  id         String               @id @default(cuid())
  storyId    String
  story      Story                @relation(fields: [storyId], references: [id], onDelete: Cascade)

  sourceType ReflectionSourceType
  // Character offsets into the body at the time of association.
  startOffset Int
  endOffset   Int
  // Snapshot of the selected text and the child's own note about it.
  selectedText String
  note         String @default("")

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([storyId])
}
