# 复制此文件为 .env.local 并按需填写。请勿提交 .env.local。
# Copy this file to .env.local and fill in as needed. Do NOT commit .env.local.

# 本地内容存放目录（可选，默认为 ~/TraceBound）
# Local content store directory (optional, defaults to ~/TraceBound)
# TRACEBOUND_HOME="/path/to/your/TraceBound"

# AI 引擎：mock（默认，无需密钥）| anthropic | openai-compat
# AI provider: mock (default, no key needed) | anthropic | openai-compat
AI_PROVIDER=mock

# --- 官方 Claude / Anthropic ---
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-4-8        # 可选 / optional
# ANTHROPIC_BASE_URL=https://...         # 可选，走代理 / optional proxy

# --- 任意 OpenAI 兼容接口（OpenAI/Kimi/DeepSeek/GLM/Ollama 等） ---
# --- Any OpenAI-compatible endpoint ---
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=sk-...
# AI_MODEL=gpt-4o-mini
